### Repositorio Nacional OAI-PMH  ------------------------------------------------
# Se emplea paquete para consulta de url OAI PMH pública del Repositorio Nacional Conacyt
# Las consultas se hacen con base en los verbos y criterios del protocolo OAI.


# ****  Paquetes empleados ------------------------------------------------------
# Cargar paquete OAIHarvester: Harvest Metadata Using OAI-PMH Version 2.0

install.packages(c("OAIHarvester", "tidyverse", "rio", "readr", "writexl", "pacman", "openxlsx"))

# Cargar bibliotecas
pacman::p_load(OAIHarvester, tidyverse, rio, readr, writexl, openxlsx)

setwd("/....../RN_2024/marzo_2025") # establecer la carpeta

# ****  Cargar URL OAI del Repositorio Nacional ---------------------------------
# ****  Variable "baseurl" contiene la URL OAI-IPMH del Repositorio Nacional

baseurl <- "https://oai-pmh.repositorionacionalcti.mx/resource/oai-pmh"


# ****  Consulta Sets cosechados y exporta a CSV --------------------------

# # # Nota: puede omitir este paso si ya se cuenta con los Sets # # #

# Variable "set_RN" con "List Set" de 108 instituciones, variable "baseurl" 
# 
set_RN <- oaih_list_sets(baseurl,transform = TRUE)

# Unir dataframe resultado de la consulta
rbind(set_RN, deparse.level = 0)

# Dimensión Sets, 2823 filas y 3 columnas dataframe, febrero 2023,
# y  2848 15 de junio 2023; 2890 11 de julio 2023; 2892 1 de agosto 2023, 
# 2 de octubre 2023, noviembre no sirvió el SSL, 2906 el 5 diciembre
# 20 enero 2024 2919, 26 de enero 2920, 3 marzo 2024 es 2920
# 30 abril 2024 2926,
# 4 julio 2024  -durante los mes de julio, agosto, septiembre, octubre y hasta el 29 noviembre SSL vencido.
# 9 diciembre es 2926
# 24 de marzo son 2926 * 100 = estimados 292,600, reportados 167,814

dim(set_RN)
View(set_RN)

# Guarda Dataframe Sets en archivo xls
write.csv(set_RN, "set_RN_24_marzo_2025.csv")

openxlsx::write.xlsx(read.csv("set_RN_24_marzo_2025.csv"), 
                     "set_RN_24_marzo_2025.xlsx")


# ****  Consulta Identifiers consechados y exporta a CSV----------------------------------------

# Consulta de las "List Identifiers" cosechadas en Repositorio Nacional
# se guarda variable "identifiers_RN". Parámetros, metadata oai_dc, 
# sin restricción de coleccion (Set), ni de fecha
# proceso tarda 4 minutos obtiene todos los identifiers de los RIACTI cosechados
identifiers_RN <- oaih_list_identifiers(baseurl, prefix = "oai_dc", from = NULL,
                           until = NULL, set = NULL, transform = TRUE)

# Dimensión Identifiers, 104807 filas febrero 2023
# 107,414 filas 16 junio 2023; 107,415 filas 1 de agosto 2023, 
# 107,415 filas 2 de octubre 2023; 108,562 filas 5 de diciembre 2023
# 109,617 filas 20 febrero 2024, 109,636 filas 26 febrero 2024
# 109,636 filas 3 marzo 2024, 110,011 filas 30 abril 2024
# 109,636 filas 4 julio 2024, 110,011 filas
# 110,011 filas 9 diciembre 2024, 110,011 filas el 4 de julio 2024
# 110,011 filas 26 marzo 2025, 110,011 filas


dim(identifiers_RN)
View(identifiers_RN)


# Guarda Dataframe Sets en archivo xls
write.csv(identifiers_RN, "identifiers_RN_24_marzo_2025.csv")

# Guarda Dataframe Identifiers en archivo xlsx
###  Esta matriz identifiers_RN incluye los registros borrados
openxlsx::write.xlsx(read.csv("identifiers_RN_24_marzo_2025.csv"), 
                     "identifiers_RN_24_marzo_2025.xlsx")


